# Required: OpenAI API key used by the researcher and writing agents
OPENAI_API_KEY=your_openai_api_key

# Server binding
PORT=3001
# HOST defaults to 127.0.0.1 without APP_API_KEY and 0.0.0.0 with it.
# HOST=127.0.0.1

# Required in production: NODE_ENV=production refuses to start without it.
# The browser asks for this key under Configuration → Server API key.
# APP_API_KEY=your_shared_secret

# Durable state: LangGraph checkpoints + per-run budgets (SQLite).
# DATA_DIR=./data
# CHECKPOINT_DB=./data/editorial.sqlite   # absolute or relative path, or "memory"
                                          # ("memory" loses paused runs on restart)

# Optional API guardrails
# MODEL_ALLOWLIST=gpt-4o,gpt-4o-mini,gpt-4.1,gpt-4.1-mini
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=20
# MAX_REQUEST_TOKENS=120000
# MAX_LLM_CALLS=15
# MAX_REQUEST_USD=2.00
# MODEL_PRICING_JSON={"gpt-4o":[2.5,10],"gpt-4o-mini":[0.15,0.6],"gpt-4.1":[2,8],"gpt-4.1-mini":[0.4,1.6]}

# Optional observability (LangSmith tracing & structured log level)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your_langsmith_api_key
# LOG_LEVEL=info
